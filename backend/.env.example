# --- Environment -------------------------------------------------------------
ENVIRONMENT=dev
PAPER_MODE=true

# --- Database ----------------------------------------------------------------
# Dev (SQLite, async): sqlite+aiosqlite:///./cfb_edge.db
# Prod (Postgres, async): postgresql+asyncpg://user:pass@host:5432/cfb_edge
DATABASE_URL=sqlite+aiosqlite:///./cfb_edge.db

# --- External APIs (server-side only; never sent to frontend) ---------------
# CollegeFootballData v2 — bearer token. Get one at https://collegefootballdata.com/key
# Free tier = 1000 calls/month. See BUILD_SPEC.md "Open Phase 0 prerequisites".
CFBD_API_KEY=

# The Odds API v4. Paid plan required for historical endpoints.
ODDS_API_KEY=

# Open-Meteo historical weather (no key required, but base URL is configurable).
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Auth (Phase 2) ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Operational (Phase 4) ---------------------------------------------------
# Webhook target for BET-signal alerts (Phase 4+).
WEBHOOK_URL=
WEBHOOK_SECRET=
