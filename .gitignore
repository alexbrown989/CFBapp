__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Virtualenvs -------------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Build / packaging -------------------------------------------------------
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# --- Databases (dev SQLite) --------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3

